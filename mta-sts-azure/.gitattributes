# Default: normalize to LF in repo, checkout as-is on Windows
* text=auto eol=lf
# Shell scripts must always be LF (will break on Linux/runners if CRLF)
*.sh text eol=lf
# Terraform files — LF
*.tf text eol=lf
*.tfvars text eol=lf
*.conf text eol=lf
# GitHub Actions workflows — LF
*.yml text eol=lf
*.yaml text eol=lf
# Web/app files — LF
*.html text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
# Binary files — no conversion
*.png binary
*.jpg binary
*.zip binary